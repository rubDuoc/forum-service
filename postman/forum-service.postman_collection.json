      "description": "",
      "item": [
        {
          "name": "Estado del servicio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"estado es UP\", function () {",
                  "    pm.expect(pm.response.json().estado).to.eql(\"UP\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "estado"
              ]
            }
          }
        }
      ]
    },
